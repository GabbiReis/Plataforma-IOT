# Copie para ".env" na pasta backend/ para rodar o backend fora do docker-compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agrinexus

# Alternativa: definir a URL completa de conexão (usada com prioridade se preenchida)
DATABASE_URL=

SECRET_KEY=troque-esta-chave
GEMINI_API_KEY=

# Origens liberadas no CORS, separadas por vírgula ("*" libera todas)
CORS_ALLOW_ORIGINS=*

# Chave que autentica a placa IoT ao enviar leituras (grave a mesma no firmware)
IOT_API_KEY=troque-esta-chave
