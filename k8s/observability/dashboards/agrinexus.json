{
  "title": "AgriNexus — API",
  "uid": "agrinexus-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requisições por segundo",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{namespace=\"agrinexus\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latência p95",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.5 },
            { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"agrinexus\"}[5m])) by (le))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxa de erro (5xx)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.01 },
            { "color": "red", "value": 0.05 }] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{namespace=\"agrinexus\",status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"agrinexus\"}[5m])), 0.001)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods do backend ativos",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "count(up{namespace=\"agrinexus\"} == 1)" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requisições por rota",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{handler}}",
          "expr": "sum(rate(http_requests_total{namespace=\"agrinexus\"}[5m])) by (handler, method)" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência por rota (p95)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "legendFormat": "{{handler}}",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"agrinexus\"}[5m])) by (le, handler))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Respostas por código de status",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}",
          "expr": "sum(rate(http_requests_total{namespace=\"agrinexus\"}[5m])) by (status)" }
      ]
    }
  ]
}
