# Copie este arquivo para "secret.env" (mesma pasta) e preencha com valores reais.
# secret.env NUNCA deve ser commitado (já está no .gitignore).
# O kustomize usa esse arquivo para gerar o Secret "agrinexus-secrets" no cluster.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agrinexus
SECRET_KEY=troque-esta-chave
GEMINI_API_KEY=
IOT_API_KEY=troque-esta-chave
