# Variáveis usadas pelo docker-compose.yml
# Copie este arquivo para ".env" e preencha com valores reais (nunca commitar o .env real)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agrinexus

# Chave usada para assinar os tokens JWT (gere uma aleatória e forte)
SECRET_KEY=troque-esta-chave

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# URL pública da API, usada para "embutir" no build do frontend (React)
REACT_APP_API_URL=http://localhost:8000

# Origens liberadas no CORS, separadas por vírgula ("*" libera todas)
CORS_ALLOW_ORIGINS=*
